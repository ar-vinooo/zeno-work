{
  "name": "zeno-work",
  "version": "0.4.0",
  "description": "Aplikasi desktop manajemen pekerjaan personal dengan WBS, timeline, dan kalender.",
  "author": "Zeno",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "next build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "desktop:dev": "npm run electron:build && node --env-file-if-exists=.env electron/dev.cjs",
    "desktop:start": "npm run build && npm run electron:build && node electron/run.cjs",
    "desktop:pack": "npm run build && npm run electron:build && electron-builder --dir",
    "desktop:dist": "npm run build && npm run electron:build && electron-builder --mac",
    "desktop:dist:mac": "npm run build && npm run electron:build && electron-builder --mac",
    "desktop:dist:win": "npm run build && npm run electron:build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsx scripts/check-tree.ts && tsx scripts/check-repository.ts",
    "test:desktop": "npm run build && npm run electron:build && tsx scripts/smoke-desktop.ts",
    "import": "tsx scripts/import-outline.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "next": "^15.5.25",
    "playwright": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.zeno.zenowork",
    "productName": "ZenoWork",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
